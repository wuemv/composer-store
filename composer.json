{
    "name": "wuemv/composer-store",
    "description": "A pnpm-style global package store for Composer: each package version is stored once and hard-linked into vendor/.",
    "type": "composer-plugin",
    "keywords": ["composer", "plugin", "store", "hardlink", "disk", "vendor"],
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "bin": ["bin/composer-store"],
    "autoload": {
        "psr-4": {
            "ComposerStore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ComposerStore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "ComposerStore\\Plugin"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:network": "phpunit --group network",
        "lint": [
            "phpcs",
            "phpstan analyse --no-progress"
        ]
    }
}
