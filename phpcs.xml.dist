<?xml version="1.0"?>
<ruleset name="composer-store">
    <description>PSR-12 for composer-store.</description>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>src</file>
    <file>tests</file>
    <file>benchmarks</file>
    <file>install.php</file>
    <file>bin/composer-store</file>
    <exclude-pattern>tests/Fixtures/*</exclude-pattern>

    <rule ref="PSR12"/>
</ruleset>
