{
    "name": "acme/patcher",
    "description": "Fixture library that ships a patch for another package, as composer-patches allows.",
    "type": "library",
    "require": {
        "acme/gamma": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Acme\\Patcher\\": "src/"
        }
    },
    "extra": {
        "patches": {
            "acme/gamma": {
                "Rename gamma": "patches/gamma.patch"
            }
        }
    }
}
